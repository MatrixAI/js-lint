{
  "name": "@matrixai/lint",
  "version": "3.0.0",
  "author": "Roger Qiu",
  "description": "Org wide custom eslint rules",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatrixAI/js-eslint.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "bin": {
    "matrixai-lint": "dist/bin/matrixai-lint.js"
  },
  "scripts": {
    "prepare": "node ./node_modules/@typescript/native/bin/tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && node ./node_modules/@typescript/native/bin/tsc -p ./tsconfig.build.json && shx chmod +x ./dist/bin/matrixai-lint.js",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "lint": "matrixai-lint --check",
    "lintfix": "matrixai-lint --fix",
    "test": "node ./scripts/test.mjs",
    "test:package-tailwind": "node ./tests/eslint/packagedTailwind.mjs",
    "test:prepare-tailwind": "npm ci --prefix ./tests/eslint/fixtures/tailwind-consumer --ignore-scripts --no-audit --fund=false"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@matrixai/logger": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "8.72.3-alpha.7",
    "@typescript-eslint/parser": "8.72.3-alpha.7",
    "@typescript-eslint/utils": "8.72.3-alpha.7",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "commander": "^13.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-tailwindcss": "4.4.1-beta.1",
    "globals": "^16.2.0",
    "ignore": "^5.3.2",
    "jsonc-parser": "3.3.1",
    "minimatch": "^10.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotschema": "0.0.3",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "vitest": "5.1.0"
  }
}
