{
  "name": "@matrixai/lint",
  "version": "1.0.2",
  "author": "Roger Qiu",
  "description": "Org wide custom eslint rules",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatrixAI/js-eslint.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configs/*.js": {
      "types": "./dist/configs/*.d.ts",
      "import": "./dist/configs/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "bin": {
    "matrixai-lint": "dist/bin/matrixai-lint.js"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json && shx chmod +x ./dist/bin/matrixai-lint.js",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "lint": "npm run prepare && node ./dist/bin/matrixai-lint.js",
    "lintfix": "npm run prepare && node ./dist/bin/matrixai-lint.js --fix",
    "test": "node ./scripts/test.mjs"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@matrixai/logger": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "commander": "^13.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "globals": "^16.2.0",
    "ignore": "^5.3.2",
    "jsonc-parser": "3.3.1",
    "minimatch": "^10.0.1",
    "prettier": "3.9.10",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@swc/core": "1.3.82",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.19.0",
    "@types/semver": "7.8.0",
    "jest": "^29.6.2",
    "jest-extended": "^4.0.2",
    "jest-junit": "^16.0.0",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "5.9.3"
  }
}
